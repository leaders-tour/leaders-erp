  segmentVersionId                 String?
  multiDayBlockId                  String?
  multiDayBlockDayOrder            Int?
  multiDayBlockConnectionId        String?
  multiDayBlockConnectionVersionId String?
  locationId                       String?
  locationVersionId                String?
  dateCellText                     String          @db.Text
  destinationCellText              String          @db.Text
  timeCellText                     String          @db.Text
  scheduleCellText                 String          @db.Text
  lodgingCellText                  String          @db.Text
  mealCellText                     String          @db.Text
  movementIntensityColorOverride   String?

  planVersion                    PlanVersion                     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  segment                        Segment?                        @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentVersion                 SegmentVersion?                 @relation(fields: [segmentVersionId], references: [id], onDelete: SetNull)
  multiDayBlock                  OvernightStay?                  @relation("PlanStopMultiDayBlock", fields: [multiDayBlockId], references: [id], onDelete: SetNull)
  multiDayBlockConnection        OvernightStayConnection?        @relation("PlanStopMultiDayBlockConnection", fields: [multiDayBlockConnectionId], references: [id], onDelete: SetNull)
  multiDayBlockConnectionVersion OvernightStayConnectionVersion? @relation("PlanStopMultiDayBlockConnectionVersion", fields: [multiDayBlockConnectionVersionId], references: [id], onDelete: SetNull)
  location                       Location?                       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationVersion                LocationVersion?                @relation(fields: [locationVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planVersionId])
  @@index([segmentId])
  @@index([segmentVersionId])
  @@index([multiDayBlockId])
  @@index([multiDayBlockConnectionId])
  @@index([multiDayBlockConnectionVersionId])
  @@index([locationId])
  @@index([locationVersionId])
}

model Lodging {
  id                   String               @id @default(uuid(7))
  locationId           String
  locationVersionId    String?
  locationNameSnapshot Json
  name                 String
  specialNotes         String?
  isUnspecified        Boolean              @default(false)
  hasElectricity       FacilityAvailability @default(NO)
  hasShower            FacilityAvailability @default(NO)
  hasInternet          FacilityAvailability @default(NO)

  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationVersion LocationVersion? @relation(fields: [locationVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([locationVersionId])
}

model RegionLodging {
  id                String  @id @default(uuid(7))
  regionId          String
  name              String
  subtitle          String?
  priceKrw          Int?
  pricePerPersonKrw Int?
  pricePerTeamKrw   Int?
  isActive          Boolean @default(true)
  sortOrder         Int     @default(0)

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId, isActive, sortOrder])
}

model MealSet {
  id                   String      @id @default(uuid(7))
  locationId           String
  locationVersionId    String?
  locationNameSnapshot Json
  setName              String
  breakfast            MealOption?
  lunch                MealOption?
  dinner               MealOption?

  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationVersion LocationVersion? @relation(fields: [locationVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationVersionId, setName])
  @@index([locationId])
  @@index([locationVersionId])
}

model TimeBlock {
  id                String                   @id @default(uuid(7))
  locationId        String
  locationVersionId String?
  profile           LocationTimeBlockProfile @default(DEFAULT)
  startTime         String
  label             String
  orderIndex        Int

  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationVersion LocationVersion? @relation(fields: [locationVersionId], references: [id], onDelete: SetNull)
  activities      Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationVersionId, profile, orderIndex])
  @@index([locationId])
  @@index([locationVersionId])
}

model Activity {
  id            String  @id @default(uuid(7))
  timeBlockId   String
  description   String
  orderIndex    Int
  isOptional    Boolean @default(false)
  conditionNote String?

  timeBlock TimeBlock @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([timeBlockId, orderIndex])
  @@index([timeBlockId])
}

model SegmentTimeBlock {
  id         String                 @id @default(uuid(7))
  segmentId  String
  variant    SegmentScheduleVariant @default(basic)
  startTime  String
  label      String
  orderIndex Int

  segment    Segment           @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activities SegmentActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([segmentId, variant, orderIndex])
  @@index([segmentId])
}

model SegmentActivity {
  id                 String  @id @default(uuid(7))
  segmentTimeBlockId String
  description        String
  orderIndex         Int
  isOptional         Boolean @default(false)
  conditionNote      String?

  segmentTimeBlock SegmentTimeBlock @relation(fields: [segmentTimeBlockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([segmentTimeBlockId, orderIndex])
  @@index([segmentTimeBlockId])
}

model OvernightStayConnectionTimeBlock {
  id                        String                 @id @default(uuid(7))
  overnightStayConnectionId String
  variant                   SegmentScheduleVariant @default(basic)
  startTime                 String
  label                     String
  orderIndex                Int

  overnightStayConnection OvernightStayConnection           @relation(fields: [overnightStayConnectionId], references: [id], onDelete: Cascade)
  activities              OvernightStayConnectionActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([overnightStayConnectionId, variant, orderIndex])
  @@index([overnightStayConnectionId])
}

model OvernightStayConnectionActivity {
  id                                 String  @id @default(uuid(7))
  overnightStayConnectionTimeBlockId String
  description                        String
  orderIndex                         Int
  isOptional                         Boolean @default(false)
  conditionNote                      String?

  overnightStayConnectionTimeBlock OvernightStayConnectionTimeBlock @relation(fields: [overnightStayConnectionTimeBlockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([overnightStayConnectionTimeBlockId, orderIndex])
  @@index([overnightStayConnectionTimeBlockId])
}

model Override {
  id            String             @id @default(uuid(7))
  planVersionId String
  targetType    OverrideTargetType
  targetId      String
  fieldName     String
  value         String

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planVersionId])
}

/// 특식(샤브/삼겹/샤슬릭) 허용·추천 키워드 규칙 단일 행 (id = default)
model SpecialMealDestinationRules {
  id      String @id
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 범용 앱 설정 저장소. key별 JSON payload를 단일 row로 보관한다.
model AppSetting {
  key     String @id
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GuideLevel {
  MAIN
  JUNIOR
  ROOKIE
  OTHER
}

enum GuideStatus {
  ACTIVE_SEASON
  INTERVIEW_DONE
  INACTIVE
  OTHER
}

enum GuideGender {
  MALE
  FEMALE
}

model Guide {
  id              String       @id @default(uuid(7))
  nameKo          String
  nameMn          String?
  level           GuideLevel   @default(OTHER)
  status          GuideStatus  @default(OTHER)
  gender          GuideGender?
  birthYear       Int?
  isSmoker        Boolean      @default(false)
  experienceYears Int?
  joinYear        Int?
  phone           String?
  profileImageUrl String?
  certImageUrls   Json         @default("[]")
  note            String?      @db.Text

  guideAssignments ConfirmedTripGuideAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([status])
}

enum DriverLevel {
  MAIN
  JUNIOR
  ROOKIE
  OTHER
}

enum DriverStatus {
  ACTIVE_SEASON
  INTERVIEW_DONE
  BLACKLISTED
  OTHER
}

enum VehicleType {
  STAREX
  HIACE_SHORT
  HIACE_LONG
  PURGON
  PREMIUM_VAN
  SUV
  LAND_CRUISER
  ALPHARD
  OTHER
}

model Driver {
  id                String       @id @default(uuid(7))
  nameMn            String
  vehicleType       VehicleType  @default(OTHER)
  vehicleNumber     String?
  vehicleOptions    String?
  vehicleYear       Int?
  maxPassengers     Int?
  level             DriverLevel  @default(OTHER)
  status            DriverStatus @default(OTHER)
  gender            GuideGender?
  birthYear         Int?
  isSmoker          Boolean      @default(false)
  hasTouristLicense Boolean      @default(false)
  joinYear          Int?
  phone             String?
  profileImageUrl   String?
  vehicleImageUrls  Json         @default("[]")
  note              String?      @db.Text

  driverAssignments ConfirmedTripDriverAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([status])
}

enum AccommodationLevel {
  LV2
  LV3
  LV4
  LV5
}

enum PaymentMethod {
  PER_PERSON
  PER_ROOM
}

enum AccommodationPriceCurrencyCode {
  MNT
  USD
}

model Accommodation {
  id              String   @id @default(uuid(7))
  name            String
  destination     String
  region          String
  // 목록·상세 커버. 미설정 시 옵션 이미지 중 첫 번째 URL 사용
  coverImageUrl   String?  @db.Text
  phone           String?
  facilities      String?
  bookingMethod   String?
  bookingPriority String?
  openingDate     String?
  closingDate     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  options  AccommodationOption[]
  lodgings ConfirmedTripLodging[]

  @@index([region])
  @@index([destination])
}

model AccommodationOption {
  id                 String             @id @default(uuid(7))
  accommodationId    String
  accommodation      Accommodation      @relation(fields: [accommodationId], references: [id])
  roomType           String
  level              AccommodationLevel @default(LV3)
  priceOffSeason     Int?
  pricePeakSeason    Int?
  priceCurrencyCode  AccommodationPriceCurrencyCode @default(MNT)
  paymentMethod      PaymentMethod?
  mealCostPerServing Int?
  capacity           Int?
  mealIncluded       Boolean            @default(false)
  googleMapsUrl      String?            @db.Text
  imageUrls          Json               @default("[]")
  note               String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmedTripLodgingOptions ConfirmedTripLodgingOption[]

  @@index([accommodationId])
  @@index([level])
}
